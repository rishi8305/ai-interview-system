# ==========================================
# AI INTERVIEW SYSTEM - ENVIRONMENT CONFIG
# ==========================================

# Flask Security Key
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# Database Configuration (defaults to SQLite if left empty)
DATABASE_URL=sqlite:///instance/interview_system.db

# AI Provider: 'gemini' or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Models to use
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Evaluation Mode:
# 'auto' = Uses AI API if key is present; falls back to labeled rule-based offline evaluator
# 'ai' = Strictly requires AI API
# 'rule_based' = Offline local rule-based evaluation (Demo Mode)
EVALUATION_MODE=auto
